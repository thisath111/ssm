<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!-- ── Identity ─────────────────────────────────────────────────────────── -->
  <assemblyIdentity
      version="2.0.0.0"
      processorArchitecture="amd64"
      name="SmartSystemManager"
      type="win32"
  />
  <description>Smart System Manager — Zero-overhead Windows optimization daemon</description>

  <!-- ── Elevation ────────────────────────────────────────────────────────── -->
  <!-- requireAdministrator: process always spawns elevated; UAC prompt shown  -->
  <!-- to the user on first launch and on each logon-task trigger.             -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- ── OS Compatibility ─────────────────────────────────────────────────── -->
  <!-- Declaring supported OS GUIDs activates modern API behaviour and         -->
  <!-- disables compatibility shims that could interfere with our mitigations. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 11 / Windows Server 2022 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 10 / Windows Server 2016+2019 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- ── DPI Awareness ────────────────────────────────────────────────────── -->
  <!-- We have no UI; this prevents Windows from applying DPI virtualisation   -->
  <!-- which would skew GetSystemMetrics screen-size checks.                   -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>

      <!-- ── Long Path Support ──────────────────────────────────────────── -->
      <!-- Opt into the Win10 1607+ long-path API so paths > MAX_PATH work. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>

      <!-- ── Heap Segment Heap ─────────────────────────────────────────── -->
      <!-- Use the modern segment heap instead of the legacy NT heap.        -->
      <!-- Provides better security isolation between allocations.           -->
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>

</assembly>
